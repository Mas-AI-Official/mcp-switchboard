        "selfDeclaredMadeForKids": {
          "type": "boolean"
        },
        "viewCount": {
          "type": "string",
          "format": "uint64",
          "readOnly": true
        }
      }
    },
    "Playlist": {
      "id": "Playlist",
      "type": "object",
      "properties": {
        "snippet": {
          "type": "object",
          "properties": {
            "title": {
