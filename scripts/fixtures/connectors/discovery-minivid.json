    "Video": {
      "id": "Video",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The video id.",
          "annotations": {
            "required": [
              "minivid.videos.update"
            ]
          }
        },
        "etag": {
          "type": "string",
          "readOnly": true
        },
        "snippet": {
          "$ref": "VideoSnippet",
          "description": "Basic details."
        },
        "status": {
          "$ref": "VideoStatus"
        },
        "replies": {
          "type": "array",
          "items": {
            "$ref": "Video"
          },
          "description": "Related videos (recursive on purpose)."
        }
      }
    },
    "VideoSnippet": {
      "id": "VideoSnippet",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "annotations": {
            "required": [
              "minivid.videos.insert",
              "minivid.videos.update"
            ]
          }
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "categoryId": {
          "type": "string"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time",
          "readOnly": true
        }
      }
    },
    "VideoStatus": {
      "id": "VideoStatus",
      "type": "object",
      "properties": {
        "privacyStatus": {
          "type": "string",
          "enum": [
            "private",
            "public",
            "unlisted"
          ],
          "enumDescriptions": [
            "",
            "",
            ""
          ]
