{
  "openapi": "3.0.3",
  "info": {
    "title": "Mini API (fixture)",
    "version": "2.1.0"
  },
  "servers": [
    {
      "url": "https://api.miniapi.fixture.test/v1"
    }
  ],
  "paths": {
    "/items": {
      "get": {
        "operationId": "listItems",
        "summary": "List items",
        "tags": [
          "Items"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "tags",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Item"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createItem",
        "summary": "Create an item",
        "tags": [
          "Items"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Item"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created"
          }
        }
      }
    },
    "/items/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "getItem",
        "summary": "Get an item",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      },
      "patch": {
        "operationId": "updateItem",
        "summary": "Update an item",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      },
      "delete": {
        "operationId": "deleteItem",
        "summary": "Delete an item",
        "responses": {
          "204": {
            "description": "gone"
          }
        }
      }
    },
    "/items/{id}/content": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "downloadItemContent",
        "summary": "Download the item's content",
        "responses": {
          "200": {
            "description": "bytes",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/items/{id}/files": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "uploadItemFile",
        "summary": "Attach a file to an item",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "caption": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/messages": {
      "post": {
        "operationId": "sendMessage",
        "summary": "Send a message to a channel",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "channel": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/search": {
      "get": {
        "operationId": "searchEverything",
        "summary": "Search (a spec hint says this read is more sensitive)",
        "x-mcp-scope": "full",
        "x-mcp-risk": "high",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/danger": {
      "delete": {
        "operationId": "deleteEverything",
        "summary": "Delete everything (a spec hint tries to call this a read)",
        "x-mcp-scope": "read",
        "x-mcp-risk": "low",
        "responses": {
          "204": {
            "description": "gone"
          }
        }
      }
    },
    "/raw": {
      "post": {
        "operationId": "uploadRaw",
        "summary": "Upload raw bytes",
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/Wins/Duplicate Name": {
      "get": {
        "operationId": "listItems",
        "summary": "A second operation with the same operationId",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "@evil.example/x": {
      "get": {
        "operationId": "hostChange",
        "summary": "A path that would change the request host",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/long/{id}": {
      "get": {
        "operationId": "anExtremelyLongOperationIdentifierThatGoesOnAndOnPastAnyReasonableToolNameBudgetAndKeepsGoing",
        "summary": "Long name",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "kind": {
            "type": "string",
            "enum": [
              "a",
              "b",
              "a",
              "b"
            ]
          },
          "code": {
            "type": "string",
            "pattern": "^[\\x00-\\x{FFFF}]*$"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          }
        }
      }
    }
  }
}
