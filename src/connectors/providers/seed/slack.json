  "owner_setup": {
    "console_url": "https://slack.com/",
    "steps": [
      "Unverified seed: this definition was derived from another project's published auth settings and has not been tested against the provider. Read the provider's own developer documentation first.",
      "Create an OAuth app in the provider's developer console and register the redirect URI below (client credentials flows need no redirect).",
      "Store the client id and secret: switchboard vault set slack_client_id and switchboard vault set slack_client_secret",
      "Register them: switchboard authconfig add slack --client-id-ref slack_client_id --client-secret-ref slack_client_secret",
      "Connect: switchboard connect slack --account <label>",
      "The 'custom' authentication of this provider takes several credential fields. This build does not drive custom authentication yet, so Connect is unavailable for that one."
    ],
    "redirect_uris": [
      "{loopback_redirect}"
    ],
    "notes": [
      "SEED, unverified. Facts (URLs, scope names, field names, a product name) were read from the Activepieces community piece 'slack' at commit 6f4be340d7c4 (MIT; see NOTICE). Nothing here was tested against the provider and it never counts as working.",
      "ASSUMED, not stated by the source: client authentication in the request body; a space between scopes; an http loopback redirect is accepted; refresh tokens that do not rotate; the credential sent as Authorization: Bearer. UNVERIFIED.",
      "api_hosts are candidates harvested from request URL settings in the piece source. Review them before relying on them: they decide where a credential may be sent."
    ]
  },
  "auth": [
    {
      "id": "oauth2",
      "mode": "oauth2",
      "label": "OAuth 2.0",
      "default": true,
      "oauth2": {
        "authorize_url": "https://slack.com/oauth/v2/authorize?user_scope=search:read,users.profile:write,reactions:read,reactions:write,im:history,stars:read,channels:write,groups:write,im:write,mpim:write,channels:write.invites,groups:write.invites,channels:history,groups:history,chat:write,users:read,usergroups:write",
        "token_url": "https://slack.com/api/oauth.v2.access",
        "pkce": "unsupported",
        "client_auth": "body",
        "client_secret_at_exchange": "always",
        "scope_separator": " ",
        "default_scopes": [
          "channels:read",
          "channels:manage",
          "channels:history",
          "chat:write",
          "groups:read",
          "groups:write",
          "groups:history",
          "reactions:read",
          "mpim:read",
          "mpim:write",
          "mpim:history",
          "im:write",
          "im:read",
          "im:history",
          "users:read",
          "files:write",
          "files:read",
          "users:read.email",
          "reactions:write",
          "usergroups:read",
          "usergroups:write",
          "chat:write.customize",
          "links:read",
          "links:write",
          "emoji:read",
          "users.profile:read",
          "channels:write.invites",
          "groups:write.invites",
          "channels:join",
          "conversations.connect:write"
        ],
        "scope_catalog": [],
        "redirect": "loopback",
        "accept_json": true,
        "refresh": {
          "kind": "refresh_token",
          "rotates": false
        }
      },
      "inject": {
        "in": "header",
        "name": "Authorization",
        "template": "Bearer {token}"
      },
      "fields": {
        "auth_config_creation": [
          {
            "name": "client_id",
            "label": "OAuth client ID",
            "required": true,
            "secret": false
          },
          {
            "name": "client_secret",
            "label": "OAuth client secret",
            "required": true,
            "secret": true
          }
        ],
        "connected_account_initiation": []
      }
    },
    {
      "id": "custom",
      "mode": "custom",
      "label": "Custom credentials",
      "inject": {
        "in": "header",
        "name": "Authorization",
        "template": "Bearer {token}"
      },
      "fields": {
        "auth_config_creation": [],
        "connected_account_initiation": [
          {
            "name": "bot_token",
            "required": true,
            "secret": true
          },
          {
            "name": "user_token",
            "required": false,
            "secret": true
          }
        ]
      }
    }
  ],
