# --- dependencies & build output ---
node_modules/
dist/
coverage/
*.tsbuildinfo

# --- secrets & local state (NEVER commit these) ---
# The vault and audit log live in ~/.switchboard by default, but ignore any
# stray copies and the live config a user fills with real server settings.
switchboard.config.yaml
.switchboard/
vault.json
vault.key
vault.key.dpapi
*.key
audit.log
audit.log.*
*.json.bak
.env
.env.*

# --- editor / OS noise ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# --- generated QA / release reports ---
report.*
*.report.json
*.report.html
qa-report.*
launch-report.*

# Keep the committed examples (these are templates, not real config):
!switchboard.config.example.yaml
!examples/switchboard.config.yaml

# local operator notes and config backups (never published)
switchboard.config.yaml.bak*
docs/STATUS-*

# --- generated connector toolkits (vendor-spec derived) ---
# `switchboard toolkits sync` writes toolkit definitions generated from providers' public specs (X, Google
# Discovery, ...) under SWITCHBOARD_HOME/toolkits/ on the operator's machine. Their redistribution terms are
# not ours to grant, so they are NEVER committed: only our code, overlays, recipes and provider definitions are.
/toolkits/
**/toolkits/generated/
*.generated.json
# a synced toolkit version directory (YYYYMMDD_NN) and its pointer, wherever a SWITCHBOARD_HOME lands
**/toolkits/*/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9]/
**/toolkits/*/current.json
# honest-count snapshot rows imported from the R1 checklists (local only)
**/connectors/coverage-rows.json
